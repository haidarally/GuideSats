# Copy to .env (git-ignored) ONLY for the opt-in real run: npm run e2e:nwc
# Never commit real values. Leave these empty in .env.example.
#
# Traveller wallet: least privilege = pay_invoice (+ get_budget, get_balance if offered)
NWC_TRAVELLER_URL=
# Guide wallet: least privilege = make_hold_invoice, settle_hold_invoice, cancel_hold_invoice, lookup_invoice
NWC_GUIDE_URL=
# Network the real wallets run on: mainnet | testnet | signet | regtest
NWC_NETWORK=
# Max sats the e2e script may move in one run (hard cap, default 100 if empty)
NWC_E2E_MAX_SATS=
